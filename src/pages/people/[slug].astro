---
import { getMemberPublications } from "../../lib/publications";
import { getCollection } from "astro:content";
import Layout from "../../components/Layout.astro";
import PublicationItem from "../../components/PublicationItem.astro";
import { withBase } from "../../lib/urls";

export async function getStaticPaths() {
  const people = await getCollection("people");
  return people.filter((person) => !person.data.isDraft).map((person) => ({
    params: { slug: person.slug },
    props: { person },
  }));
}

const { person } = Astro.props;
const { Content } = await person.render();
const memberPapers = (await getMemberPublications()).find((entry) => entry.data.member === person.slug);
const publications = (memberPapers?.data.publications ?? [])
  .filter((paper) => paper.showOnProfile)
  .sort((a, b) => a.profileOrder - b.profileOrder || b.year - a.year || a.title.localeCompare(b.title))
  .map((data) => ({ data }));
const initials = person.data.name
  .split(" ")
  .map((part) => part[0])
  .join("")
  .slice(0, 2);
const socialLinks: { label: string; url: string }[] = [];
if (person.data.mila) socialLinks.push({ label: "Mila profile", url: person.data.mila });
if (person.data.website) socialLinks.push({ label: "Personal website", url: person.data.website });
if (person.data.github) socialLinks.push({ label: "GitHub", url: person.data.github });
if (person.data.twitter) socialLinks.push({ label: "Twitter / X", url: person.data.twitter });
if (person.data.linkedin) socialLinks.push({ label: "LinkedIn", url: person.data.linkedin });
if (person.data.googleScholar) socialLinks.push({ label: "Google Scholar", url: person.data.googleScholar });
---

<Layout title={person.data.name} description={`${person.data.name}, ${person.data.role} at Marsso Lab.`}>
  <section class="page-header profile-header">
    <div class="container"><a href={withBase("/people")} class="profile-back">← All people</a></div>
    <div class="container profile-grid">
      <div class="profile-avatar">
        {person.data.image ? <img src={withBase(person.data.image)} alt="" /> : <span>{initials}</span>}
      </div>
      <div>
        <p class="eyebrow">{person.data.group}</p>
        <h1>{person.data.name}</h1>
        <p class="lede">{person.data.role}</p>
        {person.data.affiliation && <p>{person.data.affiliation}</p>}
        {person.data.supervisor && <p>Supervised by {person.data.supervisor}</p>}
        {person.data.interests.length > 0 && <p class="profile-interests">{person.data.interests.join(" · ")}</p>}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container two-column">
      <aside class="profile-sidebar card">
        <p class="meta">Contact & links</p>
        {person.data.email && <a href={`mailto:${person.data.email}`}>Send email <span aria-hidden="true">↗</span></a>}
        {person.data.orcid && <a href={`https://orcid.org/${person.data.orcid}`}>ORCID <span aria-hidden="true">↗</span></a>}
        {socialLinks.map((link) => <a href={link.url}>{link.label} <span aria-hidden="true">↗</span></a>)}
        {person.data.links.map((link) => <a href={withBase(link.url)}>{link.label} <span aria-hidden="true">↗</span></a>)}
        {person.data.posters.length > 0 && <p class="meta spacer">Posters</p>}
        {person.data.posters.map((poster) => <a href={withBase(poster.url)}>{poster.label} <span aria-hidden="true">↗</span></a>)}
      </aside>
      <div>
        <div class="prose">
          <Content />
        </div>
        {publications.length > 0 && (
          <section class="profile-publications">
            <h2>Selected publications</h2>
            {publications.map((publication) => <PublicationItem publication={publication} />)}
          </section>
        )}
      </div>
    </div>
  </section>
</Layout>

<style>
  .profile-back { display: inline-block; margin-bottom: 28px; }
  .prose :global(h2) { font-size: 1.65rem; margin-top: 32px; }
  .prose :global(p), .prose :global(li) { line-height: 1.8; }
  .profile-grid {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 30px;
    align-items: center;
  }

  .profile-interests {
    margin: 16px 0 0;
    color: var(--color-muted);
    font-size: 0.98rem;
  }

  .profile-avatar {
    display: grid;
    width: 150px;
    height: 150px;
    overflow: hidden;
    place-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: #fff;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 2.6rem;
    font-weight: 700;
  }

  .profile-avatar img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .profile-sidebar {
    position: sticky;
    top: 96px;
    display: grid;
    gap: 10px;
    padding: 28px 20px 20px;
  }

  .profile-sidebar a {
    color: var(--color-teal);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 4px;
    padding-block: 6px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .profile-sidebar a:hover { color: var(--color-ink); text-decoration-thickness: 2px; }

  .spacer {
    margin-top: 14px;
  }

  .profile-publications {
    margin-top: 48px;
  }

  @media (max-width: 720px) {
    .profile-grid {
      grid-template-columns: 1fr;
    }

    .profile-sidebar {
      position: static;
    }
  }
</style>
