---
import { getCollection } from "astro:content";
import Layout from "../components/Layout.astro";
import TalkCard from "../components/TalkCard.astro";

const talks = (await getCollection("talks")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Talks" description="Speakers and talks hosted by LM Lab.">
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">Speakers / talks</p>
      <h1>Seminars, visits, and archived conversations.</h1>
      <p class="lede">
        A lightweight archive for invited speakers, lab talks, posters, slides, and recordings.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container talk-grid">
      {talks.length > 0 ? (
        talks.map((talk) => <TalkCard talk={talk} />)
      ) : (
        <article class="empty-talks card">
          <p class="eyebrow">Talk archive</p>
          <h2>Speaker entries will appear here once confirmed.</h2>
          <p>
            This page is ready for invited talks, lab seminars, slides, recordings, and speaker bios.
          </p>
        </article>
      )}
    </div>
  </section>
</Layout>

<style>
  .talk-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 820px) {
    .talk-grid {
      grid-template-columns: 1fr;
    }
  }

  .empty-talks {
    grid-column: 1 / -1;
    padding: 24px;
  }

  .empty-talks h2 {
    margin: 12px 0;
  }
</style>
