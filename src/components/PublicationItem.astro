---
import type { CollectionEntry } from "astro:content";
import { withBase } from "../lib/urls";

interface Props {
  publication: { data: CollectionEntry<"publications">["data"]["publications"][number] };
}

const { publication } = Astro.props;
const data = publication.data;
const paperLink = data.links.find((link) => /paper|thesis/i.test(link.label));
---

<article class="publication">
  <div class="publication-year">{data.year}</div>
  <div>
    <h3>{paperLink ? <a href={paperLink.url}>{data.title}</a> : data.title}</h3>
    <p class="authors">{data.authors.join(", ")}</p>
    <p class="venue">
      <span>{data.venue}</span>
      <span>{data.type}</span>
      {data.award && <strong>{data.award}</strong>}
    </p>
    <div class="pub-links">
      {data.links.map((link) => <a href={withBase(link.url)}>{link.label}</a>)}
    </div>
  </div>
</article>

<style>
  .publication {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 20px;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .publication:first-child {
    border-top: 1px solid var(--color-border);
  }

  .publication-year {
    color: var(--color-ink);
    font-family: var(--font-meta);
    font-size: 0.95rem;
    font-weight: 500;
  }

  .publication h3 {
    margin-bottom: 7px;
    font-size: 1.35rem;
  }

  .publication h3 a { color: inherit; text-decoration: none; }
  .publication h3 a:hover { text-decoration: underline; }

  .authors,
  .venue {
    margin-bottom: 7px;
  }

  .venue {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .venue span,
  .venue strong {
    display: inline-flex;
    min-height: 24px;
    align-items: center;
    padding: 0;
    border: 0;
    border-radius: 2px;
    background: transparent;
  }

  .venue strong {
    border-color: var(--color-ink);
    color: var(--color-ink);
    background: var(--color-yellow);
  }

  .pub-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pub-links a {
    color: var(--color-teal);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 4px;
  }

  @media (max-width: 620px) {
    .publication {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
